async function initDatabase() {
  if (!pool) return;
  await pool.query(`CREATE TABLE IF NOT EXISTS tj_players (
    player_id TEXT PRIMARY KEY, name TEXT NOT NULL, total_points BIGINT NOT NULL DEFAULT 0,
    daily_points BIGINT NOT NULL DEFAULT 0, daily_date DATE, correct_answers BIGINT NOT NULL DEFAULT 0,
    games_played BIGINT NOT NULL DEFAULT 0, updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
  )`);
  await pool.query(`CREATE TABLE IF NOT EXISTS tj_questions (fingerprint TEXT PRIMARY KEY, category TEXT NOT NULL, question TEXT NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())`);
  databaseReady = true;
  console.log('Base PostgreSQL connectée.');
}
async function ensurePlayer(uid, name) {
  if (!uid) return;
  const safeName = cleanName(name);
  if (databaseReady) await pool.query(`INSERT INTO tj_players(player_id,name) VALUES($1,$2) ON CONFLICT(player_id) DO UPDATE SET name=EXCLUDED.name, updated_at=NOW()`, [uid,safeName]);
  else { const p=localScores.get(uid)||{player_id:uid,name:safeName,total_points:0,daily_points:0,correct_answers:0}; p.name=safeName; localScores.set(uid,p); }
}
async function recordScore(uid, name, points, correctDelta=0) {
  if (!uid || !Number.isFinite(points) || points <= 0) return;
  const safeName=cleanName(name), amount=Math.floor(points);
  if (databaseReady) {
    await pool.query(`INSERT INTO tj_players(player_id,name,total_points,daily_points,daily_date,correct_answers)
      VALUES($1,$2,$3,$3,(NOW() AT TIME ZONE 'Africa/Kinshasa')::date,$4)
      ON CONFLICT(player_id) DO UPDATE SET name=EXCLUDED.name,total_points=tj_players.total_points+$3,
      daily_points=CASE WHEN tj_players.daily_date=(NOW() AT TIME ZONE 'Africa/Kinshasa')::date THEN tj_players.daily_points+$3 ELSE $3 END,
      daily_date=(NOW() AT TIME ZONE 'Africa/Kinshasa')::date,correct_answers=tj_players.correct_answers+$4,updated_at=NOW()`,[uid,safeName,amount,correctDelta]);
  } else {
    const p=localScores.get(uid)||{player_id:uid,name:safeName,total_points:0,daily_points:0,correct_answers:0};
    const today=new Date().toLocaleDateString('en-CA',{timeZone:'Africa/Kinshasa'});
    if(p.daily_date!==today){p.daily_points=0;p.daily_date=today;} p.name=safeName;p.total_points+=amount;p.daily_points+=amount;p.correct_answers+=correctDelta;localScores.set(uid,p);
  }
  await broadcastLeaderboards();
}
async function recordCorrect(uid, name, points) { return recordScore(uid,name,points,1); }

async function getLeaderboard(type='general') {
  if (databaseReady) {
    const field=type==='daily'?'daily_points':'total_points';
    const result=await pool.query(`SELECT player_id AS id,name,${field} AS score,correct_answers FROM tj_players WHERE ${field}>0 ORDER BY ${field} DESC, updated_at ASC LIMIT 100`);
    return result.rows.map((p,i)=>({...p,rank:i+1,score:Number(p.score),correct_answers:Number(p.correct_answers)}));
  }
  return [...localScores.values()].filter(p=>(type==='daily'?p.daily_points:p.total_points)>0).sort((a,b)=>(type==='daily'?b.daily_points-a.daily_points:b.total_points-a.total_points)).slice(0,100).map((p,i)=>({id:p.player_id,name:p.name,score:type==='daily'?p.daily_points:p.total_points,rank:i+1,correct_answers:p.correct_answers}));
}
async function broadcastLeaderboards() {
  const [general,daily]=await Promise.all([getLeaderboard('general'),getLeaderboard('daily')]);
  io.emit('global-leaderboards',{general,daily,updatedAt:Date.now(),persistent:databaseReady});
}
async function reserveQuestion(q) {
  if (!databaseReady) return true;
  const fingerprint=norm(q.question);
  try { await pool.query('INSERT INTO tj_questions(fingerprint,category,question) VALUES($1,$2,$3)',[fingerprint,q.category,q.question]); return true; }
  catch (e) { if(e.code==='23505') return false; throw e; }
}

function cleanPlayerId(value) { const id=String(value||'').trim().slice(0,80); return /^[a-zA-Z0-9_-]{8,80}$/.test(id)?id:null; }
function cleanName(value) {
  return String(value || 'Joueur').replace(/[<>\u0000-\u001f]/g, '').trim().slice(0, 24) || 'Joueur';
}
function roomCode() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  let code;
  do { code = Array.from({length:5}, () => chars[Math.floor(Math.random()*chars.length)]).join(''); } while (rooms.has(code));
  return code;
}
function publicState(room) {
  return {
    code: room.code, category: room.category, status: room.status, roundNumber: room.roundNumber||0, questionNumber: room.questionNumber, totalQuestions: QUESTIONS_PER_ROUND, roundWinner:room.roundWinner||null,
    question: room.current ? {category:room.current.category,question:room.current.question,options:room.current.options,endsAt:room.endsAt} : null,
    players: [...room.players.values()].map(p => ({id:p.id,name:p.name,score:p.score,answered:p.answered})).sort((a,b)=>b.score-a.score),
    answerCount: [...room.players.values()].filter(p=>p.answered).length,
    playerCount: room.players.size
  };
}
function broadcast(room) { io.to(room.code).emit('room-state', publicState(room)); }
function norm(s) { return String(s || '').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]/g,''); }

async function generateQuestion(room) {
  const requested = [room.category];
  if (process.env.OPENAI_API_KEY) {
    for (let attempt=0; attempt<3; attempt++) {
      const category = requested[Math.floor(Math.random()*requested.length)];
      const recent = room.used.slice(-30);
      let globalRecent=[];
      if(databaseReady){const history=await pool.query('SELECT question FROM tj_questions ORDER BY created_at DESC LIMIT 80');globalRecent=history.rows.map(x=>x.question);}
      const prompt = `Tu es l'auteur expert de questions pour un jeu de quiz francophone. Génère UNE question originale, exacte, vérifiable et adaptée à un public général, catégorie: ${category}. Choisis aléatoirement une difficulté parmi facile, moyenne, difficile et experte. Mélange ces niveaux au fil des questions. Évite absolument ces questions déjà utilisées (empreintes locales): ${JSON.stringify(recent)}. N'utilise pas une question identique à celles-ci (questions déjà générées globalement): ${JSON.stringify(globalRecent)}. Crée 4 réponses courtes, une seule correcte. Évite les faits très récents, controversés ou ambigus. Pour les maths/logique, vérifie le résultat. Retourne uniquement un objet JSON avec les clés category, question, options (4 chaînes), correctIndex (0 à 3), explanation (une phrase).`;
      try {
        const response = await fetch('https://api.openai.com/v1/chat/completions', {
          method:'POST', headers:{'Authorization':`Bearer ${process.env.OPENAI_API_KEY}`,'Content-Type':'application/json'},
          body:JSON.stringify({model:process.env.OPENAI_MODEL || 'gpt-4o-mini',temperature:0.9,response_format:{type:'json_object'},messages:[{role:'system',content:'Réponds en français. Ne donne que du JSON valide.'},{role:'user',content:prompt}]})
        });
        if (!response.ok) throw new Error(`API IA (${response.status})`);
        const data = await response.json();
        const q = JSON.parse(data.choices?.[0]?.message?.content || '{}');
        if (typeof q.question !== 'string' || !Array.isArray(q.options) || q.options.length!==4 || !Number.isInteger(q.correctIndex) || q.correctIndex<0 || q.correctIndex>3) continue;
        q.category = requested.includes(q.category) ? q.category : category;
        q.options = q.options.map(x=>String(x).slice(0,180));
        q.question = q.question.slice(0,500); q.explanation = String(q.explanation || 'Bonne réponse.').slice(0,500);
        const fingerprint = norm(q.question);
        if (room.used.includes(fingerprint)) continue;
        if (!(await reserveQuestion(q))) continue;
        room.used.push(fingerprint); if(room.used.length>5000) room.used.shift();
        return q;
      } catch (err) { console.error('Génération IA:', err.message); break; }
    }
  }
  if (process.env.OPENAI_API_KEY) throw new Error('La génération IA a échoué après plusieurs tentatives.');
  // Banque de secours réservée aux tests unitaires ; elle ne suffit pas pour une manche complète.
  const available = fallbackQuestions.filter(q => !room.used.includes(norm(q.question)) && q.category===room.category);
  if (!available.length) throw new Error('Pas de question de secours disponible pour cette catégorie. Configure OPENAI_API_KEY pour activer les 50 catégories.');
  const q = {...available[Math.floor(Math.random()*available.length)]};
  room.used.push(norm(q.question));
  if(room.used.length>5000) room.used.shift();
  return q;
}

function chooseRoundCategory(previous='') {
  const available = process.env.OPENAI_API_KEY ? CATEGORIES : [...new Set(fallbackQuestions.map(q=>q.category))];
  const choices = available.filter(c=>c!==previous);
  return (choices.length ? choices : available)[Math.floor(Math.random()*(choices.length ? choices : available).length)];
}
function funnyLine(p, correct) {
  if (!correct) return ['Même Google vient de demander sa démission ! 😭','Le démon du doute a pris possession de ton cerveau ! 😈','Aïe… cette réponse est partie en vacances sans toi ! 😂'][Math.floor(Math.random()*3)];
  if (p.elapsedSeconds < 5) return 'ALERTE ! RINEDI FLASH est dans l’arène ! ⚡🤣';
  if (p.elapsedSeconds < 15) return 'Bien joué ! Tes neurones sont enfin connectés ! 🧠🔥';
  return 'Bonne réponse ! La vitesse n’était pas au rendez-vous, mais le cerveau a fait le travail ! 😂';
}
async function startRound(room) {
  if (!rooms.has(room.code) || room.players.size < MIN_PLAYERS) { room.status='lobby'; broadcast(room); return; }
  if (!process.env.OPENAI_API_KEY) { room.status='lobby'; io.to(room.code).emit('room-error','Pour lancer des manches complètes de 20 questions parmi les 50 catégories, configure OPENAI_API_KEY côté serveur. La banque de secours actuelle ne contient pas encore 20 questions par catégorie.'); broadcast(room); return; }
  clearTimeout(room.timer);
  room.roundNumber = (room.roundNumber || 0) + 1;
  room.questionNumber = 0;
  room.previousCategory = room.category;
  room.category = chooseRoundCategory(room.previousCategory);
  room.roundWinner = null;
  for (const p of room.players.values()) {
    p.score=0; p.correctCount=0; p.fastUnder15=0; p.fastUnder17=0; p.correctElapsedTotal=0; p.answered=false; p.lastAnswer=null;
  }
  io.to(room.code).emit('round-start',{round:room.roundNumber,category:room.category,totalQuestions:QUESTIONS_PER_ROUND,message:'Nouvelle manche ! Le Territoire a choisi une catégorie…'});
  await sendNextQuestion(room);
}
async function sendNextQuestion(room) {
  if (!rooms.has(room.code) || room.players.size < MIN_PLAYERS) { room.status='lobby'; broadcast(room); return; }
  if (!process.env.OPENAI_API_KEY) { room.status='lobby'; io.to(room.code).emit('room-error','Pour lancer des manches complètes de 20 questions parmi les 50 catégories, configure OPENAI_API_KEY côté serveur. La banque de secours actuelle ne contient pas encore 20 questions par catégorie.'); broadcast(room); return; }
  clearTimeout(room.timer); room.status='loading'; room.current=null; broadcast(room);
  try { room.current = await generateQuestion(room); }
  catch (e) {
    console.error('Question indisponible:',e.message);
    const availableCats=[...new Set(fallbackQuestions.map(q=>q.category))];
    const fallback=fallbackQuestions.find(q=>!room.used.includes(norm(q.question)) && availableCats.includes(room.category));
    if (!fallback) { room.status='lobby'; room.current=null; io.to(room.code).emit('room-error','La génération des questions a échoué ou la banque de secours est épuisée. Vérifie OPENAI_API_KEY et les quotas, puis reconnecte la salle.'); broadcast(room); return; }
    room.current={...fallback}; room.used.push(norm(fallback.question));
  }
  room.questionNumber++;
  room.status='playing'; room.questionStartedAt=Date.now(); room.endsAt=room.questionStartedAt+QUESTION_SECONDS*1000;
  for (const p of room.players.values()) { p.answered=false; p.lastAnswer=null; p.elapsedSeconds=null; p.lastAward=0; }
  io.to(room.code).emit('new-question', {round:room.roundNumber,number:room.questionNumber,total:QUESTIONS_PER_ROUND,seconds:QUESTION_SECONDS,category:room.category,question:room.current.question,options:room.current.options,endsAt:room.endsAt});
  broadcast(room);
  room.timer=setTimeout(()=>finishQuestion(room), QUESTION_SECONDS*1000);
}
async function finishRound(room) {
  room.status='round-result';
  const players=[...room.players.values()];
  for (const p of players) {
    let bonus=0;
    if (p.fastUnder15>=10) bonus=Math.max(bonus,20);
    else if (p.fastUnder17>=10) bonus=Math.max(bonus,30);
    if (p.correctCount===QUESTIONS_PER_ROUND) bonus+=50;
    if (bonus>0) { p.score+=bonus; p.roundBonus=bonus; await recordScore(p.uid,p.name,bonus,0).catch(e=>console.error('Bonus non sauvegardé:',e.message)); }
    else p.roundBonus=0;
  }
  players.sort((a,b)=>b.score-a.score || a.correctElapsedTotal-b.correctElapsedTotal || a.name.localeCompare(b.name));
  const winner=players[0] || null; room.roundWinner=winner ? {id:winner.id,name:winner.name,score:winner.score} : null;
  io.to(room.code).emit('round-result',{round:room.roundNumber,category:room.category,winner:room.roundWinner,standings:players.map(p=>({id:p.id,name:p.name,score:p.score,correctCount:p.correctCount,roundBonus:p.roundBonus||0,correctElapsedTotal:p.correctElapsedTotal})),nextRoundIn:Math.ceil(ROUND_PAUSE_MS/1000)});
  broadcast(room);
  room.timer=setTimeout(()=>startRound(room),ROUND_PAUSE_MS);
}
async function finishQuestion(room) {
  if (!room || room.status!=='playing' || !room.current) return;
  clearTimeout(room.timer); room.status='review';
  const q=room.current;
  io.to(room.code).emit('question-result',{round:room.roundNumber,number:room.questionNumber,total:QUESTIONS_PER_ROUND,correctIndex:q.correctIndex,explanation:q.explanation,correctAnswer:q.options[q.correctIndex],standings:publicState(room).players});
  broadcast(room);
  if (room.questionNumber >= QUESTIONS_PER_ROUND) { room.timer=setTimeout(()=>finishRound(room),1800); }
  else { room.timer=setTimeout(()=>sendNextQuestion(room),2500); }
}

io.on('connection', socket => {
  socket.on('create-room', async ({name,category,playerId}={}) => {
    const code=roomCode();
    const room={code,category:'Aléatoire',previousCategory:'',status:'lobby',roundNumber:0,questionNumber:0,current:null,endsAt:0,players:new Map(),used:[],timer:null,host:socket.id};
    const uid=cleanPlayerId(playerId);
    room.players.set(socket.id,{id:socket.id,uid,name:cleanName(name),score:0,correctCount:0,fastUnder15:0,fastUnder17:0,correctElapsedTotal:0,answered:false,lastAnswer:null});
    ensurePlayer(uid,name).then(broadcastLeaderboards).catch(e=>console.error('Profil:',e.message));
    rooms.set(code,room); socket.join(code); socket.data.roomCode=code;
    socket.emit('room-created',{code,host:true}); broadcast(room);
  });
  socket.on('join-room', ({name,code,playerId}={}) => {
    code=String(code||'').trim().toUpperCase(); const room=rooms.get(code);
    if(!room){socket.emit('room-error','Code introuvable. Vérifie le code de la salle.');return;}
    if(room.players.size>=50){socket.emit('room-error','Cette salle a atteint 50 joueurs.');return;}
    if(room.status!=='lobby' && room.status!=='playing' && room.status!=='loading'){socket.emit('room-error','Cette partie est en train de se terminer.');return;}
    const uid=cleanPlayerId(playerId);
    room.players.set(socket.id,{id:socket.id,uid,name:cleanName(name),score:0,correctCount:0,fastUnder15:0,fastUnder17:0,correctElapsedTotal:0,answered:false,lastAnswer:null});
    ensurePlayer(uid,name).then(broadcastLeaderboards).catch(e=>console.error('Profil:',e.message));
    socket.join(code); socket.data.roomCode=code; socket.emit('room-joined',{code,host:room.host===socket.id}); broadcast(room);
    if(room.status==='lobby' && room.players.size>=MIN_PLAYERS) { startRound(room).catch(e=>console.error('Départ manche:',e.message)); }
    if(room.status==='playing' && room.current) socket.emit('new-question',{round:room.roundNumber,number:room.questionNumber,total:QUESTIONS_PER_ROUND,seconds:Math.max(1,Math.ceil((room.endsAt-Date.now())/1000)),category:room.category,question:room.current.question,options:room.current.options,endsAt:room.endsAt});
  });
  socket.on('start-game', () => { socket.emit('room-error','Le départ est automatique dès que 2 joueurs sont présents.'); });
  socket.on('submit-answer', ({index}={}) => {
    const room=rooms.get(socket.data.roomCode); if(!room || room.status!=='playing' || !room.current) return;
    const p=room.players.get(socket.id); if(!p || p.answered || Date.now()>room.endsAt) return;
    const choice=Number(index); if(!Number.isInteger(choice) || choice<0 || choice>3) return;
    const elapsed=Math.max(1,Math.min(20,Math.ceil((Date.now()-room.questionStartedAt)/1000)));
    p.answered=true; p.lastAnswer=choice; p.elapsedSeconds=elapsed; p.lastAward=0;
    const correct=choice===room.current.correctIndex;
    if(correct) {
      const timingBonus = elapsed>=17 ? 10 : (elapsed>=15 ? 5 : 0);
      p.lastAward=elapsed+timingBonus; p.score+=p.lastAward; p.correctCount++; p.correctElapsedTotal+=elapsed;
      if(elapsed<15)p.fastUnder15++;
      if(elapsed<17)p.fastUnder17++;
      recordCorrect(p.uid,p.name,p.lastAward).catch(e=>console.error('Sauvegarde du score:',e.message));
    }
    socket.emit('answer-ack',{correct,correctIndex:room.current.correctIndex,elapsedSeconds:elapsed,basePoints:correct?elapsed:0,speedBonus:correct?(elapsed>=17?10:(elapsed>=15?5:0)):0,points:p.lastAward,funnyLine:funnyLine(p,correct)});
    broadcast(room);
    if([...room.players.values()].every(x=>x.answered)) finishQuestion(room);
  });
  socket.on('leave-room',()=>leaveRoom(socket));
  socket.on('disconnect',()=>leaveRoom(socket));
});
function leaveRoom(socket){
  const code=socket.data.roomCode; if(!code)return;
  const room=rooms.get(code); socket.data.roomCode=null;
  if(!room)return;
  room.players.delete(socket.id); socket.leave(code);
  if(room.host===socket.id){room.host=room.players.keys().next().value;io.to(code).emit('host-changed',room.host);}
  if(room.players.size===0){clearTimeout(room.timer);rooms.delete(code);}else broadcast(room);
}

async function boot() {
  if (pool) { try { await initDatabase(); } catch(e) { databaseReady=false; console.error('Base de données non disponible:',e.message); } }
  server.listen(PORT,'0.0.0.0',()=>console.log(`Le Territoire de Jece actif sur le port ${PORT}. IA: ${process.env.OPENAI_API_KEY?'activée':'désactivée (questions de secours limitées)'}. Base: ${databaseReady?'PostgreSQL':'mémoire locale uniquement'}`));
}
boot();
